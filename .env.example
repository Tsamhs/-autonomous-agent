# Αντέγραψε αυτό το αρχείο σε .env και συμπλήρωσε τις τιμές
# cp .env.example .env

# ── Απαιτητικό ──────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Προαιρετικό (υπάρχουν defaults) ─────────────────
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEMORY_K=3
MAX_ITERATIONS=5
